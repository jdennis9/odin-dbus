package odin_dbus

foreign import lib "system:dbus-1"
_ :: lib

INSIDE_DBUS_GLIB_H :: 1

GConnection :: i32

/*
* Convert to DBusMessage with dbus_g_message_get_message() in dbus-glib-lowlevel.h
*/
GMessage      :: _DBusGMessage
_DBusGMessage :: struct {}

@(default_calling_convention="c", link_prefix="dbus_")
foreign lib {
	g_connection_ref   :: proc(connection: ^GConnection) -> ^GConnection ---
	g_connection_unref :: proc(connection: ^GConnection) ---
	g_message_ref      :: proc(message: ^GMessage) -> ^GMessage ---
	g_message_unref    :: proc(message: ^GMessage) ---
	g_connection_flush :: proc(connection: ^GConnection) ---
	g_error_quark      :: proc() -> i32 ---
}

GError :: enum u32 {
	FAILED                           = 0,
	NO_MEMORY                        = 1,
	SERVICE_UNKNOWN                  = 2,
	NAME_HAS_NO_OWNER                = 3,
	NO_REPLY                         = 4,
	IO_ERROR                         = 5,
	BAD_ADDRESS                      = 6,
	NOT_SUPPORTED                    = 7,
	LIMITS_EXCEEDED                  = 8,
	ACCESS_DENIED                    = 9,
	AUTH_FAILED                      = 10,
	NO_SERVER                        = 11,
	TIMEOUT                          = 12,
	NO_NETWORK                       = 13,
	ADDRESS_IN_USE                   = 14,
	DISCONNECTED                     = 15,
	INVALID_ARGS                     = 16,
	FILE_NOT_FOUND                   = 17,
	FILE_EXISTS                      = 18,
	UNKNOWN_METHOD                   = 19,
	TIMED_OUT                        = 20,
	MATCH_RULE_NOT_FOUND             = 21,
	MATCH_RULE_INVALID               = 22,
	SPAWN_EXEC_FAILED                = 23,
	SPAWN_FORK_FAILED                = 24,
	SPAWN_CHILD_EXITED               = 25,
	SPAWN_CHILD_SIGNALED             = 26,
	SPAWN_FAILED                     = 27,
	UNIX_PROCESS_ID_UNKNOWN          = 28,
	INVALID_SIGNATURE                = 29,
	INVALID_FILE_CONTENT             = 30,
	SELINUX_SECURITY_CONTEXT_UNKNOWN = 31,
	REMOTE_EXCEPTION                 = 32,
}

@(default_calling_convention="c", link_prefix="dbus_")
foreign lib {
	g_error_has_name          :: proc(error: ^i32, name: cstring) -> i32 ---
	g_error_get_name          :: proc(error: ^i32) -> cstring ---
	g_thread_init             :: proc() ---
	g_connection_open         :: proc(address: ^i32, error: ^^i32) -> ^GConnection ---
	g_connection_open_private :: proc(address: ^i32, _context: ^i32, error: ^^i32) -> ^GConnection ---
	g_bus_get                 :: proc(type: BusType, error: ^^i32) -> ^GConnection ---
	g_bus_get_private         :: proc(type: BusType, _context: ^i32, error: ^^i32) -> ^GConnection ---
}

GObjectInfo :: _DBusGObjectInfo
GMethodInfo :: _DBusGMethodInfo

/**
* DBusGMethodInfo:
* @function: C method to invoke
* @marshaller: Marshaller to invoke method
* @data_offset: Offset into the introspection data
*
* Object typically generated by #dbus-binding-tool that
* stores a mapping from introspection data to a
* function pointer for a C method to be invoked.
*/
_DBusGMethodInfo :: struct {}

/**
* DBusGObjectInfo:
* @format_version: Allows us to change the rest of this struct
*   by adding DBusGObjectInfo2, DBusGObjectInfo3, etc.
* @method_infos:  Array of method pointers
* @n_method_infos: Length of the infos array
* @data: Introspection data
* @exported_signals: Exported signals
* @exported_properties: Exported properties
*
* Introspection data for a #GObject, normally autogenerated by
* a tool such as #dbus-binding-tool.
*/
_DBusGObjectInfo :: struct {}

@(default_calling_convention="c", link_prefix="dbus_")
foreign lib {
	glib_global_set_disable_legacy_property_access :: proc() ---
	g_object_type_install_info                     :: proc(object_type: i32, info: ^GObjectInfo) ---
	g_object_type_register_shadow_property         :: proc(iface_type: i32, dbus_prop_name: cstring, shadow_prop_name: cstring) ---
	g_error_domain_register                        :: proc(domain: i32, default_iface: cstring, code_enum: i32) ---
	g_connection_register_g_object                 :: proc(connection: ^GConnection, at_path: cstring, object: ^i32) ---
	g_connection_unregister_g_object               :: proc(connection: ^GConnection, object: ^i32) ---
	g_connection_lookup_g_object                   :: proc(connection: ^GConnection, at_path: cstring) -> ^i32 ---
}

gchar      :: i32
GSignature :: gchar

@(default_calling_convention="c", link_prefix="dbus_")
foreign lib {
	g_object_register_marshaller       :: proc(marshaller: i32, rettype: i32, #c_vararg _: ..any) ---
	g_object_register_marshaller_array :: proc(marshaller: i32, rettype: i32, n_types: i32, types: ^i32) ---
}

GProxy           :: _DBusGProxy
GProxyClass      :: _DBusGProxyClass
_DBusGProxy      :: struct {}
_DBusGProxyClass :: struct {}
_DBusGProxyCall  :: struct {}
GProxyCall       :: _DBusGProxyCall
GProxyCallNotify :: proc "c" (proxy: ^GProxy, call_id: ^GProxyCall, user_data: rawptr)

@(default_calling_convention="c", link_prefix="dbus_")
foreign lib {
	g_proxy_new_for_name            :: proc(connection: ^GConnection, name: cstring, path: cstring, iface: cstring) -> ^GProxy ---
	g_proxy_new_for_name_owner      :: proc(connection: ^GConnection, name: cstring, path: cstring, iface: cstring, error: ^^i32) -> ^GProxy ---
	g_proxy_new_from_proxy          :: proc(proxy: ^GProxy, iface: cstring, path: cstring) -> ^GProxy ---
	g_proxy_new_for_peer            :: proc(connection: ^GConnection, path: cstring, iface: cstring) -> ^GProxy ---
	g_proxy_set_interface           :: proc(proxy: ^GProxy, interface_name: cstring) ---
	g_proxy_add_signal              :: proc(proxy: ^GProxy, signal_name: cstring, first_type: i32, #c_vararg _: ..any) ---
	g_proxy_connect_signal          :: proc(proxy: ^GProxy, signal_name: cstring, handler: i32, data: rawptr, free_data_func: i32) ---
	g_proxy_disconnect_signal       :: proc(proxy: ^GProxy, signal_name: cstring, handler: i32, data: rawptr) ---
	g_proxy_call                    :: proc(^GProxy, cstring, ^^i32, i32, #c_vararg ..any) -> i32 ---
	g_proxy_call_with_timeout       :: proc(^GProxy, cstring, i32, ^^i32, i32, #c_vararg ..any) -> i32 ---
	g_proxy_call_no_reply           :: proc(proxy: ^GProxy, method: cstring, first_arg_type: i32, #c_vararg _: ..any) ---
	g_proxy_begin_call              :: proc(proxy: ^GProxy, method: cstring, notify: GProxyCallNotify, user_data: gpointer, destroy: i32, first_arg_type: i32, #c_vararg _: ..any) -> ^GProxyCall ---
	g_proxy_begin_call_with_timeout :: proc(proxy: ^GProxy, method: cstring, notify: GProxyCallNotify, user_data: gpointer, destroy: i32, timeout: i32, first_arg_type: i32, #c_vararg _: ..any) -> ^GProxyCall ---
	g_proxy_set_default_timeout     :: proc(proxy: ^GProxy, timeout: i32) ---
	g_proxy_end_call                :: proc(^GProxy, ^GProxyCall, ^^i32, i32, #c_vararg ..any) -> i32 ---
	g_proxy_cancel_call             :: proc(proxy: ^GProxy, call: ^GProxyCall) ---
	g_proxy_get_path                :: proc(proxy: ^GProxy) -> cstring ---
	g_proxy_get_bus_name            :: proc(proxy: ^GProxy) -> cstring ---
	g_proxy_get_interface           :: proc(proxy: ^GProxy) -> cstring ---
}

_DBusGMethodInvocation :: struct {}
GMethodInvocation      :: _DBusGMethodInvocation

@(default_calling_convention="c", link_prefix="dbus_")
foreign lib {
	g_method_return                      :: proc(_context: ^GMethodInvocation, #c_vararg _: ..any) ---
	g_method_return_error                :: proc(_context: ^GMethodInvocation, error: ^i32) ---
	g_method_invocation_get_g_connection :: proc(_context: ^GMethodInvocation) -> ^GConnection ---
}

/* Probably possible to replace this with a closure */
GAsyncData :: struct {
	cb:       i32,
	userdata: gpointer,
}

